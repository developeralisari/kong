{
  "annotations": { "list": [] },
  "description": "Kong Gateway temel metrikleri",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "uid": "kong-uat-overview",
  "title": "Kong UAT — Overview",
  "tags": ["kong", "uat"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 2,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "current": { "text": "VictoriaMetrics", "value": "VictoriaMetrics" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Requests (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{"color": "#73BF69", "value": null}] } } },
      "targets": [{ "refId": "A", "expr": "sum(increase(kong_http_requests_total[$__rate_interval]))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate (5xx)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{"color": "#73BF69", "value": null}, {"color": "#FF5733", "value": 0.01}] } } },
      "targets": [{ "refId": "A", "expr": "sum(rate(kong_http_requests_total{code=~\"5..\"}[$__rate_interval])) / sum(rate(kong_http_requests_total[$__rate_interval]))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg Latency (p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "steps": [{"color": "#73BF69", "value": null}, {"color": "#FADE2A", "value": 1000}, {"color": "#FF5733", "value": 5000}] } } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(kong_http_latency_ms_bucket[$__rate_interval])))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Services",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{"color": "#73BF69", "value": null}] } } },
      "targets": [{ "refId": "A", "expr": "count(count by (service) (kong_http_requests_total))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 15, "drawStyle": "line", "showPoints": "never" } } },
      "targets": [{ "refId": "A", "expr": "sum by (service) (rate(kong_http_requests_total[$__rate_interval]))", "legendFormat": "{{service}}" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 8, "drawStyle": "line" } } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(kong_http_latency_ms_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(kong_http_latency_ms_bucket[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(kong_http_latency_ms_bucket[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Status Code (req/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 20, "drawStyle": "bars", "stacking": { "mode": "normal" } } } },
      "targets": [{ "refId": "A", "expr": "sum by (code) (rate(kong_http_requests_total[$__rate_interval]))", "legendFormat": "{{code}}" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Bandwidth (bytes/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2, "fillOpacity": 10, "drawStyle": "line" } } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(kong_bandwidth_bytes{direction=\"ingress\"}[$__rate_interval]))", "legendFormat": "Ingress" },
        { "refId": "B", "expr": "sum(rate(kong_bandwidth_bytes{direction=\"egress\"}[$__rate_interval]))", "legendFormat": "Egress" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Upstream Latency (p95, ms)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 10, "drawStyle": "line" } } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, service) (rate(kong_upstream_latency_ms_bucket[$__rate_interval])))", "legendFormat": "{{service}}" }]
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Top Routes (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{"color": "#73BF69", "value": null}] } } },
      "targets": [{ "refId": "A", "expr": "topk(10, sum by (route) (increase(kong_http_requests_total[5m])))", "legendFormat": "{{route}}" }],
      "options": { "orientation": "horizontal", "displayMode": "gradient" }
    }
  ]
}
