{
  "annotations": { "list": [] },
  "description": "MedGemma AI Gateway - billing, consumer usage, upstream health",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "uid": "medgemma-ai-gateway",
  "title": "MedGemma AI Gateway — Billing",
  "tags": ["kong", "medgemma", "billing", "uat"],
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 3,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "current": { "text": "VictoriaMetrics", "value": "VictoriaMetrics" },
        "hide": 0
      },
      {
        "name": "consumer",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "label": "Consumer",
        "query": "label_values(kong_http_requests_total{consumer!=\"\"}, consumer)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "stat",
      "title": "Input Tokens (24h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{"color": "#73BF69", "value": null}] } } },
      "targets": [{ "refId": "A", "expr": "sum(increase(medgemma_input_tokens_total[24h]))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Output Tokens (24h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{"color": "#73BF69", "value": null}] } } },
      "targets": [{ "refId": "A", "expr": "sum(increase(medgemma_output_tokens_total[24h]))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Jobs Completed (24h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{"color": "#73BF69", "value": null}] } } },
      "targets": [{ "refId": "A", "expr": "sum(increase(medgemma_jobs_completed_total[24h]))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Avg Job Duration",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [{"color": "#73BF69", "value": null}, {"color": "#FADE2A", "value": 30}, {"color": "#FF5733", "value": 120}] } } },
      "targets": [{ "refId": "A", "expr": "rate(medgemma_job_duration_seconds_sum[5m]) / rate(medgemma_job_duration_seconds_count[5m])" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Token Consumption (tokens/min)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 15, "drawStyle": "line", "showPoints": "never" } } },
      "targets": [
        { "refId": "A", "expr": "sum by (consumer) (rate(medgemma_input_tokens_total[$__rate_interval]) * 60)", "legendFormat": "{{consumer}} input" },
        { "refId": "B", "expr": "sum by (consumer) (rate(medgemma_output_tokens_total[$__rate_interval]) * 60)", "legendFormat": "{{consumer}} output" }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Job Duration (seconds)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10, "drawStyle": "line" } } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(medgemma_job_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(medgemma_job_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Total Requests (24h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{"color": "#73BF69", "value": null}] } } },
      "targets": [{ "refId": "A", "expr": "sum(increase(kong_http_requests_total{consumer=~\"$consumer\"}[24h]))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg Response Time (p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "steps": [{"color": "#73BF69", "value": null}, {"color": "#FADE2A", "value": 2000}, {"color": "#FF5733", "value": 10000}] } } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(kong_upstream_latency_ms_bucket{consumer=~\"$consumer\"}[$__rate_interval])))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate (5xx)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{"color": "#73BF69", "value": null}, {"color": "#FF5733", "value": 0.01}] } } },
      "targets": [{ "refId": "A", "expr": "sum(rate(kong_http_requests_total{code=~\"5..\",consumer=~\"$consumer\"}[$__rate_interval])) / sum(rate(kong_http_requests_total{consumer=~\"$consumer\"}[$__rate_interval]))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Consumers",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{"color": "#73BF69", "value": null}] } } },
      "targets": [{ "refId": "A", "expr": "count(count by (consumer) (kong_http_requests_total{consumer!=\"\"}))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests by Consumer (req/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 15, "drawStyle": "line", "showPoints": "never" } } },
      "targets": [{ "refId": "A", "expr": "sum by (consumer) (rate(kong_http_requests_total{consumer=~\"$consumer\",consumer!=\"\"}[$__rate_interval]))", "legendFormat": "{{consumer}}" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Upstream Latency by Consumer (p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 10, "drawStyle": "line" } } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, consumer) (rate(kong_upstream_latency_ms_bucket{consumer=~\"$consumer\",consumer!=\"\"}[$__rate_interval])))", "legendFormat": "{{consumer}}" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Status Codes",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 20, "drawStyle": "bars", "stacking": { "mode": "normal" } } } },
      "targets": [{ "refId": "A", "expr": "sum by (code) (rate(kong_http_requests_total{consumer=~\"$consumer\"}[$__rate_interval]))", "legendFormat": "{{code}}" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Bandwidth by Consumer",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2, "fillOpacity": 10, "drawStyle": "line" } } },
      "targets": [
        { "refId": "A", "expr": "sum by (consumer) (rate(kong_bandwidth_bytes{direction=\"egress\",consumer=~\"$consumer\",consumer!=\"\"}[$__rate_interval]))", "legendFormat": "{{consumer}} egress" }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Consumer Usage (24h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 33 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "consumer" }, "properties": [{ "id": "custom.width", "value": 200 }] }
        ]
      },
      "targets": [
        { "refId": "A", "expr": "sum by (consumer) (increase(kong_http_requests_total{consumer!=\"\"}[24h]))", "legendFormat": "{{consumer}}", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "consumer": "Consumer", "Value": "Requests (24h)" } } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Requests (24h)", "desc": true }] } }
      ],
      "options": { "showHeader": true, "footer": { "show": false } }
    }
  ]
}
